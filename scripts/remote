#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SESSIONS_DIR="${REMOTE_SESSIONS_DIR:-$ROOT/.sessions}"
COMMAND="${1:-help}"
NAME="${REMOTE_NAME:-${2:-}}"

die() {
	printf 'remote: %s\n' "$*" >&2
	exit 1
}

note() {
	printf 'remote: %s\n' "$*"
}

need() {
	command -v "$1" >/dev/null 2>&1 || die "missing '$1' ($2)"
}

validate_name() {
	[[ -n "$NAME" ]] || die "NAME is required"
	[[ "$NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] ||
		die "NAME must match [a-zA-Z0-9][a-zA-Z0-9._-]*"
}

positive_integer() {
	local label="$1" value="$2"
	[[ "$value" =~ ^[1-9][0-9]*$ ]] || die "$label must be a positive integer"
}

nonnegative_integer() {
	local label="$1" value="$2"
	[[ "$value" =~ ^[0-9]+$ ]] || die "$label must be a non-negative integer"
}

session_dir() {
	printf '%s/%s\n' "$SESSIONS_DIR" "$NAME"
}

session_file() {
	printf '%s/session.json\n' "$(session_dir)"
}

require_session() {
	validate_name
	[[ -f "$(session_file)" ]] || die "session '$NAME' is not tracked; run 'task remote:list'"
}

sandbox_name_for() {
	local repo_slug raw
	repo_slug="$(basename "$ROOT")"
	raw="${REMOTE_PREFIX:-$repo_slug}-$NAME"
	printf '%s' "$raw" |
		tr '[:upper:]_' '[:lower:]-' |
		sed -E 's/[^a-z0-9.-]+/-/g; s/^-+//; s/-+$//' |
		cut -c1-63
}

sandbox_name_from_session() {
	jq -er '.sandbox.name' "$(session_file)"
}

session_uses_infisical() {
	jq -e '.secrets.infisical.enabled == true' "$(session_file)" >/dev/null 2>&1
}

session_uses_aperture() {
	jq -e '.network.aperture.enabled == true' "$(session_file)" >/dev/null 2>&1
}

join_shell_args() {
	local argument
	for argument in "$@"; do
		printf "'"
		printf '%s' "$argument" | sed "s/'/'\\\\''/g"
		printf "' "
	done
}

daytona_config_file() {
	if [[ -n "${DAYTONA_CONFIG_DIR:-}" ]]; then
		printf '%s/config.json\n' "$DAYTONA_CONFIG_DIR"
	elif [[ "$(uname -s)" == "Darwin" ]]; then
		printf '%s/Library/Application Support/daytona/config.json\n' "$HOME"
	else
		printf '%s/.config/daytona/config.json\n' "$HOME"
	fi
}

create_ssh_token() {
	local sandbox="$1" expires_minutes="$2"
	local config profile_id api_url api_key access_token organization_id response
	config="$(daytona_config_file)"
	[[ -f "$config" ]] || die "Daytona login configuration not found; run 'task remote:login'"

	# Refresh a browser-login token before reading the CLI-owned config.
	daytona list --format json >/dev/null

	profile_id="$(jq -er '.activeProfile' "$config")"
	api_url="$(jq -er --arg id "$profile_id" '.profiles[] | select(.id == $id) | .api.url' "$config")"
	api_key="$(jq -r --arg id "$profile_id" '.profiles[] | select(.id == $id) | .api.key // empty' "$config")"

	if [[ -n "$api_key" ]]; then
		response="$(
			printf 'header = "Authorization: Bearer %s"\n' "$api_key" |
				curl -fsS --config - -X POST \
					"$api_url/sandbox/$sandbox/ssh-access?expiresInMinutes=$expires_minutes"
		)"
	else
		access_token="$(jq -er --arg id "$profile_id" '.profiles[] | select(.id == $id) | .api.token.accessToken' "$config")"
		organization_id="$(jq -er --arg id "$profile_id" '.profiles[] | select(.id == $id) | .activeOrganizationId' "$config")"
		response="$(
			printf 'header = "Authorization: Bearer %s"\nheader = "X-Daytona-Organization-ID: %s"\n' \
				"$access_token" "$organization_id" |
				curl -fsS --config - -X POST \
					"$api_url/sandbox/$sandbox/ssh-access?expiresInMinutes=$expires_minutes"
		)"
	fi

	printf '%s' "$response" | jq -er '.token'
}

print_ssh_client_config() {
	local sandbox="$1" expires_minutes="$2" ssh_token
	ssh_token="$(create_ssh_token "$sandbox" "$expires_minutes")"
	printf 'Host daytona-session\n'
	printf '  HostName ssh.app.daytona.io\n'
	printf '  User %s\n' "$ssh_token"
	printf '  ServerAliveInterval 30\n'
	printf '  ServerAliveCountMax 3\n'
	printf '  StrictHostKeyChecking accept-new\n'
	unset ssh_token
}

write_ssh_client_config() {
	local output="$3"
	umask 077
	print_ssh_client_config "$1" "$2" >"$output"
}

context_parts() {
	local context="${REMOTE_CONTEXT:-adhoc}"
	if [[ "$context" == *:* ]]; then
		CONTEXT_KIND="${context%%:*}"
		CONTEXT_REF="${context#*:}"
	else
		CONTEXT_KIND="$context"
		CONTEXT_REF=""
	fi

	case "$CONTEXT_KIND" in
	issue | pr | branch | adhoc | task | spike | review) ;;
	*) die "unsupported CONTEXT kind '$CONTEXT_KIND' (use issue, pr, branch, adhoc, task, spike, or review)" ;;
	esac

	if [[ "$CONTEXT_KIND" == "issue" || "$CONTEXT_KIND" == "pr" ]]; then
		[[ "$CONTEXT_REF" =~ ^[0-9]+$ ]] ||
			die "CONTEXT=$CONTEXT_KIND requires a numeric reference, for example $CONTEXT_KIND:123"
	fi
}

github_https_url() {
	local url="$1"
	case "$url" in
	git@github.com:*)
		printf 'https://github.com/%s\n' "${url#git@github.com:}"
		;;
	ssh://git@github.com/*)
		printf 'https://github.com/%s\n' "${url#ssh://git@github.com/}"
		;;
	*)
		printf '%s\n' "$url"
		;;
	esac
}

github_context_url() {
	local repo="$1" base="${repo%.git}"
	case "$CONTEXT_KIND" in
	issue) printf '%s/issues/%s\n' "$base" "$CONTEXT_REF" ;;
	pr) printf '%s/pull/%s\n' "$base" "$CONTEXT_REF" ;;
	branch) printf '%s/tree/%s\n' "$base" "$CONTEXT_REF" ;;
	*) printf '\n' ;;
	esac
}

write_session_helpers() {
	local dir="$1" quoted_name quoted_script
	quoted_name="$(join_shell_args "$NAME")"
	quoted_script="$(join_shell_args "$ROOT/scripts/remote")"
	cat >"$dir/ssh" <<EOF
#!/usr/bin/env sh
REMOTE_NAME=$quoted_name exec $quoted_script ssh "\$@"
EOF
	chmod 700 "$dir/ssh"

	cat >"$dir/exec" <<EOF
#!/usr/bin/env sh
exec daytona exec $(printf '%q' "$2") -- "\$@"
EOF
	chmod 700 "$dir/exec"
}

refresh_sandbox_info() {
	local sandbox="$1" dir="$2"
	if command -v daytona >/dev/null 2>&1; then
		daytona info "$sandbox" --format json >"$dir/sandbox.json" 2>"$dir/daytona-info.log" || true
	fi
}

update_local_state() {
	local state="$1" file tmp
	file="$(session_file)"
	tmp="$(mktemp "${TMPDIR:-/tmp}/remote-session.XXXXXX")"
	jq --arg state "$state" --arg now "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
		'.localState = $state | .updatedAt = $now' "$file" >"$tmp"
	mv "$tmp" "$file"
}

bootstrap_git() {
	local sandbox="$1" repo="$2" source_ref="$3"
	local workspace="/workspace"

	if daytona exec "$sandbox" -- test -d "$workspace/.git" >/dev/null 2>&1; then
		return
	fi

	daytona exec "$sandbox" --timeout 0 -- git clone "$repo" "$workspace"

	case "$CONTEXT_KIND" in
	pr)
		daytona exec "$sandbox" -- git -C "$workspace" fetch origin "pull/$CONTEXT_REF/head"
		daytona exec "$sandbox" -- git -C "$workspace" checkout -B "remote/pr-$CONTEXT_REF" FETCH_HEAD
		;;
	branch)
		daytona exec "$sandbox" -- git -C "$workspace" fetch origin "$CONTEXT_REF"
		daytona exec "$sandbox" -- git -C "$workspace" checkout -B "$CONTEXT_REF" FETCH_HEAD
		;;
	issue)
		daytona exec "$sandbox" -- git -C "$workspace" fetch origin "$source_ref"
		daytona exec "$sandbox" -- git -C "$workspace" checkout --detach FETCH_HEAD
		daytona exec "$sandbox" -- git -C "$workspace" checkout -B "remote/issue-$CONTEXT_REF"
		;;
	*)
		daytona exec "$sandbox" -- git -C "$workspace" fetch origin "$source_ref"
		daytona exec "$sandbox" -- git -C "$workspace" checkout --detach FETCH_HEAD
		daytona exec "$sandbox" -- git -C "$workspace" checkout -B "remote/$NAME"
		;;
	esac
}

infisical_access_token() {
	if [[ -n "${INFISICAL_TOKEN:-}" ]]; then
		[[ "${INFISICAL_ALLOW_TOKEN:-0}" == "1" ]] ||
			die "set INFISICAL_ALLOW_TOKEN=1 to explicitly use INFISICAL_TOKEN"
		printf '%s' "$INFISICAL_TOKEN"
		return
	fi

	need infisical "run 'task secrets:init'"
	[[ -n "${INFISICAL_CLIENT_ID:-}" ]] || die "INFISICAL_CLIENT_ID is required"
	[[ -n "${INFISICAL_CLIENT_SECRET:-}" ]] || die "INFISICAL_CLIENT_SECRET is required"

	local -a login_args
	login_args=(
		login
		--method=universal-auth
		--silent
		--plain
	)
	[[ -z "${INFISICAL_DOMAIN:-}" ]] || login_args+=(--domain="$INFISICAL_DOMAIN")
	INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$INFISICAL_CLIENT_ID" \
		INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$INFISICAL_CLIENT_SECRET" \
		infisical "${login_args[@]}"
}

bootstrap_infisical() {
	local sandbox="$1" token="$2" install_script
	install_script='set -eu; IFS= read -r token; token_file="${INFISICAL_TOKEN_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/infisical/access-token}"; temp_file="${token_file}.tmp.$$"; trap "rm -f \"$temp_file\"" EXIT; umask 077; mkdir -p "$(dirname "$token_file")"; printf "%s" "$token" >"$temp_file"; unset token; chmod 600 "$temp_file"; mv "$temp_file" "$token_file"; trap - EXIT'
	printf "sh -c '%s'\n%s\n" "$install_script" "$token" |
		daytona ssh "$sandbox" --expires 5
}

tailscale_auth_key() {
	need node "install Node.js 18 or newer"
	[[ -n "${TAILSCALE_OAUTH_CLIENT_ID:-}" ]] || die "TAILSCALE_OAUTH_CLIENT_ID is required"
	[[ -n "${TAILSCALE_OAUTH_CLIENT_SECRET:-}" ]] || die "TAILSCALE_OAUTH_CLIENT_SECRET is required"

	TAILSCALE_OAUTH_CLIENT_ID="$TAILSCALE_OAUTH_CLIENT_ID" \
		TAILSCALE_OAUTH_CLIENT_SECRET="$TAILSCALE_OAUTH_CLIENT_SECRET" \
		node --input-type=module <<'NODE'
const clientId = process.env.TAILSCALE_OAUTH_CLIENT_ID;
const clientSecret = process.env.TAILSCALE_OAUTH_CLIENT_SECRET;

const tokenResponse = await fetch("https://api.tailscale.com/api/v2/oauth/token", {
  method: "POST",
  headers: { "content-type": "application/x-www-form-urlencoded" },
  body: new URLSearchParams({ client_id: clientId, client_secret: clientSecret }),
});
if (!tokenResponse.ok) {
  throw new Error(`Tailscale OAuth failed with HTTP ${tokenResponse.status}`);
}
const { access_token: accessToken } = await tokenResponse.json();

const keyResponse = await fetch("https://api.tailscale.com/api/v2/tailnet/-/keys", {
  method: "POST",
  headers: {
    authorization: `Bearer ${accessToken}`,
    "content-type": "application/json",
  },
  body: JSON.stringify({
    capabilities: {
      devices: {
        create: {
          reusable: false,
          ephemeral: true,
          preauthorized: true,
          tags: ["tag:daytona"],
        },
      },
    },
    expirySeconds: 600,
  }),
});
if (!keyResponse.ok) {
  throw new Error(`Tailscale auth-key creation failed with HTTP ${keyResponse.status}`);
}
const { key } = await keyResponse.json();
process.stdout.write(key);
NODE
}

bootstrap_aperture() {
	local sandbox="$1" auth_key="$2" private_key public_key encrypted_key
	private_key="/tmp/aperture-bootstrap-key-$$.pem"

	daytona exec "$sandbox" -- openssl genpkey \
		-algorithm RSA \
		-pkeyopt rsa_keygen_bits:2048 \
		-out "$private_key" >/dev/null
	public_key="$(daytona exec "$sandbox" -- openssl pkey -in "$private_key" -pubout)"
	[[ "$public_key" == *"BEGIN PUBLIC KEY"* ]] ||
		die "sandbox did not return an Aperture bootstrap public key"

	encrypted_key="$({
		TAILSCALE_AUTH_KEY="$auth_key" APERTURE_PUBLIC_KEY="$public_key" \
			node --input-type=module <<'NODE'
import { constants, publicEncrypt } from "node:crypto";

const ciphertext = publicEncrypt(
  {
    key: process.env.APERTURE_PUBLIC_KEY,
    padding: constants.RSA_PKCS1_OAEP_PADDING,
  },
  Buffer.from(process.env.TAILSCALE_AUTH_KEY),
);
process.stdout.write(ciphertext.toString("base64"));
NODE
	})"
	[[ "$encrypted_key" =~ ^[a-zA-Z0-9+/=]+$ ]] ||
		die "failed to encrypt the one-use Tailscale key"

	if daytona exec "$sandbox" -- \
		start-aperture-bridge-encrypted "$encrypted_key" "$private_key"; then
		daytona exec "$sandbox" -- rm -f "$private_key" >/dev/null
	else
		daytona exec "$sandbox" -- rm -f "$private_key" >/dev/null 2>&1 || true
		return 1
	fi
}

cmd_check() {
	need git "install Git"
	need jq "brew install jq"
	need task "brew install go-task"
	if ! command -v daytona >/dev/null 2>&1; then
		printf '%s\n' \
			"Daytona CLI is not installed." \
			"Install: task remote:init" \
			"Login:   task remote:login"
		return 1
	fi
	daytona version
	note "dependencies look good"
}

cmd_init() {
	if command -v daytona >/dev/null 2>&1; then
		note "Daytona CLI is already installed"
		daytona version
		return
	fi

	local os architecture download_url download_file
	os="$(uname -s)"

	case "$os" in
	Darwin)
		need brew "install Homebrew from https://brew.sh"
		brew install daytonaio/cli/daytona
		if brew help trust >/dev/null 2>&1; then
			brew trust daytonaio/cli ||
				note "warning: Daytona installed, but Homebrew could not trust its tap"
		fi
		;;
	Linux)
		need curl "install curl with your system package manager"
		architecture="$(uname -m)"
		case "$architecture" in
		x86_64 | amd64) architecture="amd64" ;;
		aarch64 | arm64) architecture="arm64" ;;
		*) die "unsupported Linux architecture '$architecture'" ;;
		esac

		download_url="https://github.com/daytona/clients/releases/latest/download/daytona-linux-$architecture"
		download_file="$(mktemp "${TMPDIR:-/tmp}/daytona.XXXXXX")"
		curl -fL "$download_url" -o "$download_file"
		chmod 755 "$download_file"
		sudo install -m 755 "$download_file" /usr/local/bin/daytona
		rm -f "$download_file"
		;;
	*)
		die "automatic installation is supported on macOS and Linux; see https://www.daytona.io/docs/en/tools/cli/"
		;;
	esac

	command -v daytona >/dev/null 2>&1 ||
		die "installation finished but 'daytona' is not on PATH"
	daytona version
	note "Daytona CLI installed; next run: task remote:login"
}

cmd_secrets_init() {
	if command -v infisical >/dev/null 2>&1; then
		note "Infisical CLI is already installed"
		infisical --version
		return
	fi

	case "$(uname -s)" in
	Darwin)
		need brew "install Homebrew from https://brew.sh"
		brew install infisical/get-cli/infisical
		;;
	Linux)
		need npm "install Node.js and npm"
		npm install --global @infisical/cli@0.43.114
		;;
	*) die "automatic Infisical CLI installation is supported on macOS and Linux" ;;
	esac

	infisical --version
}

cmd_secrets_check() {
	need infisical "run 'task secrets:init'"
	[[ -n "${INFISICAL_PROJECT_ID:-}" ]] || die "INFISICAL_PROJECT_ID is required"
	local token
	token="$(infisical_access_token)"
	INFISICAL_TOKEN="$token" INFISICAL_DISABLE_UPDATE_CHECK=true infisical export \
		--projectId="$INFISICAL_PROJECT_ID" \
		--env="${INFISICAL_ENVIRONMENT:-dev}" \
		--path="${INFISICAL_SECRET_PATH:-/}" \
		--format=json >/dev/null
	note "Infisical authentication and project configuration are available"
}

cmd_login() {
	need daytona "run 'task remote:init'"

	if [[ -n "${DAYTONA_API_KEY:-}" ]]; then
		note "logging in with DAYTONA_API_KEY"
		daytona login --api-key "$DAYTONA_API_KEY"
	else
		note "opening Daytona browser login"
		daytona login
	fi

	note "login complete; verify with: task remote:check"
}

cmd_snapshot() {
	need daytona "brew install daytonaio/cli/daytona, then run 'daytona login'"

	local snapshot dockerfile context cpu memory disk region repo_slug
	repo_slug="$(basename "$ROOT" | tr '[:upper:]_' '[:lower:]-')"
	snapshot="${REMOTE_SNAPSHOT:-$repo_slug-dev}"
	dockerfile="${REMOTE_DOCKERFILE:-.devcontainer/Dockerfile}"
	context="${REMOTE_BUILD_CONTEXT:-.devcontainer}"
	cpu="${REMOTE_SNAPSHOT_CPU:-2}"
	memory="${REMOTE_SNAPSHOT_MEMORY:-4}"
	disk="${REMOTE_SNAPSHOT_DISK:-10}"
	region="${REMOTE_REGION:-}"

	positive_integer "CPU" "$cpu"
	positive_integer "MEMORY" "$memory"
	positive_integer "DISK" "$disk"
	[[ -f "$ROOT/$dockerfile" ]] || die "Dockerfile not found: $dockerfile"
	[[ -d "$ROOT/$context" ]] || die "build context not found: $context"

	local -a snapshot_args
	snapshot_args=(
		snapshot create "$snapshot"
		--dockerfile "$dockerfile"
		--context "$context"
		--cpu "$cpu"
		--memory "$memory"
		--disk "$disk"
	)
	[[ -z "$region" ]] || snapshot_args+=(--region "$region")

	note "building Daytona snapshot '$snapshot' from $dockerfile"
	(
		cd "$ROOT"
		daytona "${snapshot_args[@]}"
	)
	note "use it with: task remote:start NAME=01 SNAPSHOT=$snapshot"
}

cmd_start() {
	validate_name
	context_parts
	need daytona "brew install daytonaio/cli/daytona, then run 'daytona login'"
	need jq "brew install jq"

	local dir sandbox repo source_ref commit branch context_url clone config config_file
	local build_dockerfile build_context
	local snapshot_override
	local cpu memory memory_gb disk auto_stop snapshot target infisical_enabled infisical_environment
	local infisical_path infisical_token aperture_enabled aperture_host aperture_model
	local aperture_port tailscale_key
	dir="$(session_dir)"
	[[ ! -e "$dir" ]] || die "session '$NAME' already exists at $dir"
	config_file="${REMOTE_CONFIG_FILE:-$ROOT/config.yaml}"
	[[ -f "$config_file" ]] || die "remote create config not found: $config_file"
	config="$(node "$ROOT/scripts/read-remote-config.mjs" "$config_file")"

	sandbox="$(sandbox_name_for)"
	repo="${REMOTE_REPO:-$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)}"
	repo="$(github_https_url "$repo")"
	branch="$(git -C "$ROOT" branch --show-current)"
	source_ref="${REMOTE_GIT_REF:-${branch:-HEAD}}"
	commit="$(git -C "$ROOT" rev-parse HEAD)"
	context_url="$(github_context_url "$repo")"
	clone="${REMOTE_CLONE:-$(jq -r '.clone' <<<"$config")}"
	cpu="${REMOTE_CPU:-$(jq -r '.resources.cpu' <<<"$config")}"
	memory="${REMOTE_MEMORY:-$(jq -r '.resources.memoryMb' <<<"$config")}"
	disk="${REMOTE_DISK:-$(jq -r '.resources.diskGb' <<<"$config")}"
	auto_stop="${REMOTE_AUTO_STOP:-$(jq -r '.autoStopMinutes' <<<"$config")}"
	snapshot_override="${REMOTE_SNAPSHOT:-}"
	if [[ "$snapshot_override" == "none" || "$snapshot_override" == "null" ]]; then
		snapshot=""
	else
		snapshot="${snapshot_override:-$(jq -r '.snapshot // empty' <<<"$config")}"
	fi
	target="${REMOTE_TARGET:-$(jq -r '.target // empty' <<<"$config")}"
	build_dockerfile="$(jq -r '.build.dockerfile // empty' <<<"$config")"
	build_context="$(jq -r '.build.context // empty' <<<"$config")"
	infisical_enabled="${REMOTE_INFISICAL:-0}"
	infisical_environment="${INFISICAL_ENVIRONMENT:-dev}"
	infisical_path="${INFISICAL_SECRET_PATH:-/}"
	aperture_enabled="${REMOTE_APERTURE:-0}"
	aperture_host="${REMOTE_APERTURE_HOST:-${APERTURE_HOST:-}}"
	aperture_model="${REMOTE_APERTURE_MODEL:-${APERTURE_MODEL:-gpt-5.5}}"
	aperture_port="${REMOTE_APERTURE_PORT:-${APERTURE_LOCAL_PORT:-41111}}"

	positive_integer "CPU" "$cpu"
	positive_integer "MEMORY" "$memory"
	((memory >= 1024 && memory % 1024 == 0)) || die "MEMORY must be a whole number of GiB expressed in MB"
	memory_gb="$((memory / 1024))"
	positive_integer "DISK" "$disk"
	nonnegative_integer "AUTO_STOP" "$auto_stop"
	positive_integer "APERTURE_PORT" "$aperture_port"
	((aperture_port <= 65535)) || die "APERTURE_PORT must not exceed 65535"
	case "$clone" in
	1 | true) clone=1 ;;
	0 | false) clone=0 ;;
	*) die "CLONE must be true, false, 1, or 0" ;;
	esac
	case "$target" in
	"" | eu | us) ;;
	*) die "TARGET must be eu or us" ;;
	esac

	local -a create_args
	create_args=(
		create
		--name "$sandbox"
		--auto-stop "$auto_stop"
		--label "managed-by=task-remote"
		--label "session-name=$NAME"
		--label "context-kind=$CONTEXT_KIND"
	)
	if [[ -n "$snapshot" ]]; then
		create_args+=(--snapshot "$snapshot")
	else
		[[ -n "$build_dockerfile" ]] || die "remote.create.build.dockerfile is required without a snapshot"
		[[ -n "$build_context" ]] || die "remote.create.build.context is required without a snapshot"
		[[ -f "$ROOT/$build_dockerfile" ]] || die "Dockerfile not found: $build_dockerfile"
		[[ -d "$ROOT/$build_context" ]] || die "build context not found: $build_context"
		create_args+=(
			--dockerfile "$ROOT/$build_dockerfile"
			--context "$ROOT/$build_context"
			--cpu "$cpu"
			--memory "$memory_gb"
			--disk "$disk"
		)
	fi
	[[ -z "$target" ]] || create_args+=(--target "$target")
	if [[ "$infisical_enabled" == "1" || "$infisical_enabled" == "true" ]]; then
		[[ -n "${INFISICAL_PROJECT_ID:-}" ]] || die "INFISICAL_PROJECT_ID is required when Infisical is enabled"
		[[ -n "$snapshot" ]] || die "SNAPSHOT is required when Infisical is enabled"
		create_args+=(
			--env "INFISICAL_PROJECT_ID=$INFISICAL_PROJECT_ID"
			--env "INFISICAL_ENVIRONMENT=$infisical_environment"
			--env "INFISICAL_SECRET_PATH=$infisical_path"
			--env "INFISICAL_DISABLE_UPDATE_CHECK=true"
		)
		[[ -z "${INFISICAL_DOMAIN:-}" ]] || create_args+=(--env "INFISICAL_DOMAIN=$INFISICAL_DOMAIN")
		infisical_token="$(infisical_access_token)"
	fi
	if [[ "$aperture_enabled" == "1" || "$aperture_enabled" == "true" ]]; then
		[[ -n "$snapshot" ]] || die "SNAPSHOT is required when Aperture is enabled"
		[[ "$aperture_host" =~ ^[a-zA-Z0-9.-]+$ ]] ||
			die "APERTURE_HOST must be a DNS hostname without a scheme or path"
		[[ "$aperture_model" =~ ^[a-zA-Z0-9._-]+$ ]] ||
			die "APERTURE_MODEL contains unsupported characters"
		create_args+=(
			--env "APERTURE_HOST=$aperture_host"
			--env "APERTURE_LOCAL_PORT=$aperture_port"
			--env "APERTURE_BASE_URL=http://127.0.0.1:$aperture_port/codex"
			--env "APERTURE_MODEL=$aperture_model"
			--env "APERTURE_NODE_NAME=$sandbox"
		)
		tailscale_key="$(tailscale_auth_key)"
	fi

	if ! git -C "$ROOT" diff --quiet || ! git -C "$ROOT" diff --cached --quiet; then
		note "warning: the local worktree is dirty; uncommitted files will not be cloned"
	fi
	note "creating Daytona sandbox '$sandbox'"
	daytona "${create_args[@]}"
	mkdir -p "$dir"
	jq -n \
		--arg name "$NAME" \
		--arg sandboxName "$sandbox" \
		--arg createdAt "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
		'{
			schemaVersion: 1,
			name: $name,
			localState: "bootstrap-pending",
			sandbox: { name: $sandboxName },
			workspace: "/workspace",
			createdAt: $createdAt,
			updatedAt: $createdAt
		}' >"$dir/session.json"
	write_session_helpers "$dir" "$sandbox"
	local sandbox_ready=0 attempt
	for attempt in $(seq 1 30); do
		if daytona exec "$sandbox" -- true >/dev/null 2>&1; then
			sandbox_ready=1
			break
		fi
		sleep 1
	done
	if [[ "$sandbox_ready" != "1" ]]; then
		update_local_state "running-bootstrap-failed"
		die "sandbox '$sandbox' did not become ready for command execution"
	fi
	daytona exec "$sandbox" -- mkdir -p /workspace
	if daytona exec "$sandbox" -- command -v tmux >/dev/null 2>&1 &&
		! daytona exec "$sandbox" -- tmux has-session -t dev >/dev/null 2>&1; then
		daytona exec "$sandbox" -- tmux new-session -d -s dev -c /workspace
	fi
	if [[ "$infisical_enabled" == "1" || "$infisical_enabled" == "true" ]]; then
		if ! daytona exec "$sandbox" -- \
			"command -v infisical >/dev/null && command -v with-infisical >/dev/null"; then
			note "snapshot does not contain infisical and with-infisical; deleting sandbox"
			if daytona delete "$sandbox" >/dev/null 2>&1; then
				update_local_state "deleted-bootstrap-failed"
			else
				update_local_state "running-bootstrap-failed"
				note "automatic deletion failed; recover with: task remote:destroy NAME=$NAME"
			fi
			return 1
		elif bootstrap_infisical "$sandbox" "$infisical_token"; then
			note "Infisical access token installed with mode 0600"
		else
			note "Infisical bootstrap failed; deleting sandbox"
			if daytona delete "$sandbox" >/dev/null 2>&1; then
				update_local_state "deleted-bootstrap-failed"
			else
				update_local_state "running-bootstrap-failed"
				note "automatic deletion failed; recover with: task remote:destroy NAME=$NAME"
			fi
			return 1
		fi
	fi
	if [[ "$aperture_enabled" == "1" || "$aperture_enabled" == "true" ]]; then
		if ! daytona exec "$sandbox" -- \
			"command -v codex >/dev/null && command -v ts-unplug >/dev/null && command -v start-aperture-bridge >/dev/null"; then
			note "snapshot does not contain Codex and the Aperture bridge; deleting sandbox"
			if daytona delete "$sandbox" >/dev/null 2>&1; then
				update_local_state "deleted-bootstrap-failed"
			else
				update_local_state "running-bootstrap-failed"
				note "automatic deletion failed; recover with: task remote:destroy NAME=$NAME"
			fi
			return 1
		elif bootstrap_aperture "$sandbox" "$tailscale_key" >"$dir/aperture-bootstrap.log" 2>&1; then
			tailscale_key=""
			note "ephemeral Tailscale bridge connected to Aperture"
		else
			tailscale_key=""
			daytona exec "$sandbox" -- \
				"cat \"\${APERTURE_STATE_DIR:-\${XDG_STATE_HOME:-\$HOME/.local/state}/aperture-tsnet}/ts-unplug.log\"" \
				>>"$dir/aperture-bootstrap.log" 2>&1 || true
			note "Aperture bootstrap failed; deleting sandbox"
			if daytona delete "$sandbox" >/dev/null 2>&1; then
				update_local_state "deleted-bootstrap-failed"
			else
				update_local_state "running-bootstrap-failed"
				note "automatic deletion failed; recover with: task remote:destroy NAME=$NAME"
			fi
			return 1
		fi
	fi

	refresh_sandbox_info "$sandbox" "$dir"

	jq -n \
		--arg name "$NAME" \
		--arg sandboxName "$sandbox" \
		--arg kind "$CONTEXT_KIND" \
		--arg ref "$CONTEXT_REF" \
		--arg url "$context_url" \
		--arg purpose "${REMOTE_PURPOSE:-}" \
		--arg repo "$repo" \
		--arg gitRef "$source_ref" \
		--arg commit "$commit" \
		--argjson dirty "$(git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet && printf false || printf true)" \
		--arg snapshot "$snapshot" \
		--arg target "${target:-default}" \
		--argjson cpu "$cpu" \
		--argjson memoryMb "$memory" \
		--argjson diskGb "$disk" \
		--argjson autoStopMinutes "$auto_stop" \
		--argjson infisicalEnabled "$([[ "$infisical_enabled" == "1" || "$infisical_enabled" == "true" ]] && printf true || printf false)" \
		--arg infisicalEnvironment "$infisical_environment" \
		--arg infisicalPath "$infisical_path" \
		--argjson apertureEnabled "$([[ "$aperture_enabled" == "1" || "$aperture_enabled" == "true" ]] && printf true || printf false)" \
		--arg apertureHost "$aperture_host" \
		--arg apertureModel "$aperture_model" \
		--argjson aperturePort "$aperture_port" \
		--arg createdAt "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
		'{
			schemaVersion: 1,
			name: $name,
			localState: "running",
			context: {
				kind: $kind,
				ref: (if $ref == "" then null else $ref end),
				url: (if $url == "" then null else $url end),
				purpose: (if $purpose == "" then null else $purpose end)
			},
			source: {
				repository: $repo,
				gitRef: $gitRef,
				localCommit: $commit,
				localWorktreeWasDirty: $dirty
			},
			sandbox: {
				name: $sandboxName,
				snapshot: (if $snapshot == "" then null else $snapshot end),
				target: $target,
				cpu: $cpu,
				memoryMb: $memoryMb,
				diskGb: $diskGb,
				autoStopMinutes: $autoStopMinutes
			},
			secrets: {
				infisical: {
					enabled: $infisicalEnabled,
					environment: $infisicalEnvironment,
					path: $infisicalPath
				}
			},
			network: {
				aperture: {
					enabled: $apertureEnabled,
					host: (if $apertureHost == "" then null else $apertureHost end),
					model: $apertureModel,
					localPort: $aperturePort,
					ephemeral: true
				}
			},
			workspace: "/workspace",
			commands: {
				ssh: ("task remote:ssh NAME=" + $name),
				info: ("task remote:info NAME=" + $name),
				stop: ("task remote:stop NAME=" + $name),
				resume: ("task remote:resume NAME=" + $name)
			},
			createdAt: $createdAt,
			updatedAt: $createdAt
		}' >"$dir/session.json"

	if [[ "$clone" == "1" || "$clone" == "true" ]]; then
		if [[ -z "$repo" ]]; then
			note "no Git remote found; sandbox was created without cloning"
		elif bootstrap_git "$sandbox" "$repo" "$source_ref" >"$dir/bootstrap.log" 2>&1; then
			note "repository prepared at /workspace"
		else
			update_local_state "running-bootstrap-failed"
			note "sandbox is running, but repository bootstrap failed; see $dir/bootstrap.log"
			note "private repositories need credentials configured inside Daytona"
			return 1
		fi
	fi

	note "session saved to $dir"
	note "connect with: task remote:ssh NAME=$NAME"
}

cmd_list() {
	need jq "brew install jq"
	mkdir -p "$SESSIONS_DIR"

	local found=0 file sandbox remote_state
	printf '%-18s %-12s %-18s %-28s %s\n' "NAME" "STATE" "CONTEXT" "SANDBOX" "PURPOSE"
	while IFS= read -r file; do
		found=1
		sandbox="$(jq -r '.sandbox.name' "$file")"
		remote_state="$(jq -r '.localState // "unknown"' "$file")"
		if command -v daytona >/dev/null 2>&1; then
			remote_state="$(
				daytona info "$sandbox" --format json 2>/dev/null |
					jq -r '.state // .sandbox.state // empty' || true
			)"
			[[ -n "$remote_state" ]] || remote_state="$(jq -r '.localState // "unknown"' "$file")"
		fi
		jq -r --arg state "$remote_state" '
			[
				.name,
				$state,
				(.context.kind + (if .context.ref then ":" + .context.ref else "" end)),
				.sandbox.name,
				(.context.purpose // "")
			] | @tsv
		' "$file" |
			awk -F '\t' '{ printf "%-18s %-12s %-18s %-28s %s\n", $1, $2, $3, $4, $5 }'
	done < <(find "$SESSIONS_DIR" -mindepth 2 -maxdepth 2 -name session.json -not -path '*/.archive/*' -print | sort)

	[[ "$found" == "1" ]] || note "no tracked sessions"
}

cmd_info() {
	require_session
	local sandbox dir
	sandbox="$(sandbox_name_from_session)"
	dir="$(session_dir)"
	refresh_sandbox_info "$sandbox" "$dir"
	jq -n \
		--slurpfile session "$dir/session.json" \
		--slurpfile sandbox "$dir/sandbox.json" \
		'{session: $session[0], daytona: ($sandbox[0] // null)}'
}

cmd_ssh() {
	require_session
	need daytona "brew install daytonaio/cli/daytona, then run 'daytona login'"
	need ssh "install OpenSSH"
	local sandbox ssh_config expires_minutes status
	sandbox="$(sandbox_name_from_session)"
	expires_minutes="${REMOTE_SSH_EXPIRES_MINUTES:-1440}"
	positive_integer "EXPIRES_MINUTES" "$expires_minutes"

	if ! daytona exec "$sandbox" -- command -v tmux >/dev/null 2>&1; then
		exec daytona ssh "$sandbox" --expires "$expires_minutes"
	fi

	ssh_config="$(mktemp "${TMPDIR:-/tmp}/daytona-ssh.XXXXXX")"
	trap 'rm -f "$ssh_config"' EXIT INT TERM
	write_ssh_client_config "$sandbox" "$expires_minutes" "$ssh_config"
	ssh -F "$ssh_config" -t daytona-session \
		tmux new-session -A -s dev -c /workspace
	status="$?"
	rm -f "$ssh_config"
	trap - EXIT INT TERM
	return "$status"
}

cmd_exec() {
	require_session
	need daytona "brew install daytonaio/cli/daytona, then run 'daytona login'"
	[[ -n "${REMOTE_COMMAND:-}" ]] || die "CMD is required"
	local with_secrets="${REMOTE_WITH_SECRETS:-0}" sandbox remote_command
	sandbox="$(sandbox_name_from_session)"
	if [[ "$with_secrets" == "1" || "$with_secrets" == "true" ]]; then
		session_uses_infisical || die "session '$NAME' was not created with Infisical"
		remote_command="$(join_shell_args with-infisical sh -lc "$REMOTE_COMMAND")"
	else
		remote_command="$(join_shell_args sh -lc "$REMOTE_COMMAND")"
	fi
	exec daytona exec "$sandbox" --cwd /workspace -- "$remote_command"
}

cmd_secrets_refresh() {
	require_session
	need daytona "run 'task remote:init'"
	local sandbox token
	session_uses_infisical || die "session '$NAME' was not created with Infisical"
	sandbox="$(sandbox_name_from_session)"
	daytona start "$sandbox" >/dev/null 2>&1 || true
	token="$(infisical_access_token)"
	bootstrap_infisical "$sandbox" "$token"
	note "refreshed the Infisical access token for '$NAME'"
}

cmd_secrets_export() {
	require_session
	need daytona "run 'task remote:init'"
	local sandbox workspace output_file remote_command
	session_uses_infisical || die "session '$NAME' was not created with Infisical"
	sandbox="$(sandbox_name_from_session)"
	workspace="$(jq -er '.workspace' "$(session_file)")"
	output_file="${REMOTE_ENV_FILE:-.env.local}"
	[[ "$output_file" != /* && "$output_file" != *..* ]] ||
		die "ENV_FILE must be a relative path without '..'"
	remote_command="$(join_shell_args with-infisical --export "$output_file")"
	daytona exec "$sandbox" --cwd "$workspace" -- "$remote_command"
	note "exported Infisical secrets to $workspace/$output_file with mode 0600"
}

cmd_aperture_check() {
	require_session
	need daytona "run 'task remote:init'"
	session_uses_aperture || die "session '$NAME' was not created with Aperture"
	local sandbox port
	sandbox="$(sandbox_name_from_session)"
	port="$(jq -er '.network.aperture.localPort' "$(session_file)")"
	daytona exec "$sandbox" -- curl -fsS "http://127.0.0.1:$port/v1/models" >/dev/null
	note "Aperture bridge is available in '$NAME'"
}

cmd_codex_login() {
	require_session
	need daytona "run 'task remote:init'"
	session_uses_aperture || die "session '$NAME' was not created with Aperture"
	exec daytona exec "$(sandbox_name_from_session)" --timeout 0 -- \
		codex login --device-auth
}

cmd_url() {
	require_session
	need daytona "run 'task remote:init'"

	local sandbox port expires url dir
	sandbox="$(sandbox_name_from_session)"
	port="${REMOTE_PORT:-5173}"
	expires="${REMOTE_EXPIRES:-86400}"
	dir="$(session_dir)/ports"

	positive_integer "PORT" "$port"
	positive_integer "EXPIRES" "$expires"

	url="$(daytona preview-url "$sandbox" --port "$port" --expires "$expires" | tail -n 1)"
	[[ "$url" == http://* || "$url" == https://* ]] ||
		die "Daytona did not return a preview URL"

	mkdir -p "$dir"
	jq -n \
		--argjson port "$port" \
		--arg url "$url" \
		--argjson expiresInSeconds "$expires" \
		--arg generatedAt "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
		'{
			port: $port,
			url: $url,
			expiresInSeconds: $expiresInSeconds,
			generatedAt: $generatedAt
		}' >"$dir/$port.json"
	printf '%s\n' "$url" >"$dir/$port.url"

	note "saved port mapping to $dir/$port.json"
	printf '%s\n' "$url"
}

cmd_serve() {
	require_session
	need daytona "run 'task remote:init'"

	local sandbox workspace port expires command log_file ready attempt
	local with_secrets launch_command remote_command
	sandbox="$(sandbox_name_from_session)"
	workspace="$(jq -er '.workspace' "$(session_file)")"
	port="${REMOTE_PORT:-5173}"
	expires="${REMOTE_EXPIRES:-86400}"
	command="${REMOTE_COMMAND:-pnpm exec vite dev --host 0.0.0.0 --port $port}"
	with_secrets="${REMOTE_WITH_SECRETS:-0}"
	if [[ "$with_secrets" == "1" || "$with_secrets" == "true" ]]; then
		session_uses_infisical || die "session '$NAME' was not created with Infisical"
		launch_command="$(join_shell_args with-infisical sh -lc "$command")"
	else
		launch_command="$(join_shell_args sh -lc "$command")"
	fi
	log_file="/tmp/remote-$NAME-$port.log"
	remote_command="nohup $launch_command>$(printf '%q' "$log_file") 2>&1 &"
	ready=0

	positive_integer "PORT" "$port"
	positive_integer "EXPIRES" "$expires"

	note "starting on port $port: $command"
	daytona exec "$sandbox" --cwd "$workspace" -- "$remote_command"

	for attempt in $(seq 1 30); do
		if daytona exec "$sandbox" -- \
			curl -fsS -o /dev/null "http://127.0.0.1:$port/" >/dev/null 2>&1; then
			ready=1
			break
		fi
		sleep 1
	done

	if [[ "$ready" != "1" ]]; then
		note "server did not become ready; remote log follows"
		daytona exec "$sandbox" -- cat "$log_file" || true
		return 1
	fi

	note "server is healthy on port $port"
	REMOTE_PORT="$port" REMOTE_EXPIRES="$expires" cmd_url
}

cmd_portless() {
	require_session
	need daytona "run 'task remote:init'"
	need portless "install with 'npm install --global portless'"
	need curl "install curl"
	need ssh "install OpenSSH"

	local sandbox remote_port local_port proxy_port alias expires_minutes checksum
	local dir metadata metadata_temp tunnel_log tunnel_pid url ready attempt
	local alias_registered=0 tunnel_committed=0
	sandbox="$(sandbox_name_from_session)"
	remote_port="${REMOTE_PORT:-5173}"
	proxy_port="${REMOTE_PORTLESS_PROXY_PORT:-1355}"
	alias="${REMOTE_PORTLESS_ALIAS:-$NAME}"
	expires_minutes="${REMOTE_SSH_EXPIRES_MINUTES:-1440}"
	dir="$(session_dir)/portless"
	metadata="$dir/$remote_port.json"
	tunnel_log="$dir/$remote_port-ssh.log"
	ready=0

	positive_integer "PORT" "$remote_port"
	positive_integer "PROXY_PORT" "$proxy_port"
	positive_integer "EXPIRES_MINUTES" "$expires_minutes"
	[[ "$alias" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] ||
		die "ALIAS must contain only letters, numbers, dots, and hyphens"

	if [[ -n "${REMOTE_LOCAL_PORT:-}" ]]; then
		local_port="$REMOTE_LOCAL_PORT"
	else
		checksum="$(printf '%s' "$sandbox:$remote_port" | cksum | awk '{print $1}')"
		local_port="$((40000 + checksum % 10000))"
	fi
	positive_integer "LOCAL_PORT" "$local_port"

	if [[ -f "$metadata" ]]; then
		tunnel_pid="$(jq -r '.tunnelPid // empty' "$metadata")"
		if [[ "$tunnel_pid" =~ ^[0-9]+$ ]] &&
			kill -0 "$tunnel_pid" 2>/dev/null &&
			curl --max-time 2 -sS -o /dev/null "http://127.0.0.1:$local_port/" 2>/dev/null; then
			note "reusing active SSH tunnel on local port $local_port"
			ready=1
		fi
	fi

	if [[ "$ready" != "1" ]]; then
		if lsof -nP -iTCP:"$local_port" -sTCP:LISTEN >/dev/null 2>&1; then
			die "local port $local_port is already in use"
		fi

		mkdir -p "$dir"
		trap 'if [[ "${tunnel_committed:-0}" != "1" ]]; then if [[ "${alias_registered:-0}" == "1" ]]; then portless alias --remove "$alias" >/dev/null 2>&1 || true; fi; rm -f "${metadata_temp:-}"; if [[ "${tunnel_pid:-}" =~ ^[0-9]+$ ]]; then kill "$tunnel_pid" 2>/dev/null || true; wait "$tunnel_pid" 2>/dev/null || true; fi; fi' EXIT INT TERM
		print_ssh_client_config "$sandbox" "$expires_minutes" |
			nohup ssh -F /dev/stdin -N \
			-o ExitOnForwardFailure=yes \
			-L "$local_port:127.0.0.1:$remote_port" \
			daytona-session \
			>"$tunnel_log" 2>&1 &
		tunnel_pid="$!"

		for attempt in $(seq 1 15); do
			if curl --max-time 2 -sS -o /dev/null "http://127.0.0.1:$local_port/" 2>/dev/null; then
				ready=1
				break
			fi
			if ! kill -0 "$tunnel_pid" 2>/dev/null; then
				break
			fi
			sleep 1
		done

		if [[ "$ready" != "1" ]]; then
			note "SSH tunnel failed; see $tunnel_log"
			kill "$tunnel_pid" 2>/dev/null || true
			wait "$tunnel_pid" 2>/dev/null || true
			trap - EXIT INT TERM
			return 1
		fi
	fi

	portless proxy start --no-tls --port "$proxy_port"
	portless alias "$alias" "$local_port" --force
	alias_registered=1
	url="http://$alias.localhost:$proxy_port"
	metadata_temp="$(mktemp "$dir/.metadata.XXXXXX")"

	jq -n \
		--arg sandbox "$sandbox" \
		--argjson remotePort "$remote_port" \
		--argjson localPort "$local_port" \
		--arg alias "$alias" \
		--argjson proxyPort "$proxy_port" \
		--argjson tunnelPid "$tunnel_pid" \
		--arg url "$url" \
		--arg createdAt "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
		'{
			state: "running",
			sandbox: $sandbox,
			remotePort: $remotePort,
			localPort: $localPort,
			alias: $alias,
			proxyPort: $proxyPort,
			tunnelPid: $tunnelPid,
			url: $url,
			createdAt: $createdAt
		}' >"$metadata_temp"
	mv "$metadata_temp" "$metadata"
	metadata_temp=""
	tunnel_committed=1
	trap - EXIT INT TERM

	note "local tunnel $local_port -> $sandbox:$remote_port"
	printf '%s\n' "$url"
}

cmd_portless_stop() {
	require_session
	need jq "brew install jq"

	local dir metadata tunnel_pid local_port alias
	dir="$(session_dir)/portless"
	[[ -d "$dir" ]] || die "session '$NAME' has no tracked Portless tunnels"

	while IFS= read -r metadata; do
		tunnel_pid="$(jq -r '.tunnelPid // empty' "$metadata")"
		local_port="$(jq -r '.localPort' "$metadata")"
		alias="$(jq -r '.alias' "$metadata")"

		if [[ "$tunnel_pid" =~ ^[0-9]+$ ]] && kill -0 "$tunnel_pid" 2>/dev/null; then
			if ps -p "$tunnel_pid" -o command= | grep -F -- "$local_port:127.0.0.1" >/dev/null; then
				kill "$tunnel_pid"
			else
				note "refusing to stop PID $tunnel_pid because it is not the tracked SSH tunnel"
			fi
		fi

		if command -v portless >/dev/null 2>&1; then
			portless alias --remove "$alias" || true
		fi

		jq --arg stoppedAt "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
			'.state = "stopped" | .stoppedAt = $stoppedAt' "$metadata" >"$metadata.tmp"
		mv "$metadata.tmp" "$metadata"
		note "stopped local tunnel for $alias (local port $local_port)"
	done < <(find "$dir" -maxdepth 1 -name '*.json' -type f -print)
}

cmd_stop() {
	require_session
	need daytona "brew install daytonaio/cli/daytona, then run 'daytona login'"
	local sandbox
	sandbox="$(sandbox_name_from_session)"
	daytona stop "$sandbox"
	update_local_state "stopped"
	refresh_sandbox_info "$sandbox" "$(session_dir)"
	note "stopped '$NAME'; metadata and remote filesystem were preserved"
}

cmd_resume() {
	require_session
	need daytona "brew install daytonaio/cli/daytona, then run 'daytona login'"
	local sandbox
	sandbox="$(sandbox_name_from_session)"
	daytona start "$sandbox"
	if session_uses_aperture; then
		daytona exec "$sandbox" -- start-aperture-bridge </dev/null
	fi
	update_local_state "running"
	refresh_sandbox_info "$sandbox" "$(session_dir)"
	note "resumed '$NAME'"
}

cmd_destroy() {
	require_session
	need daytona "brew install daytonaio/cli/daytona, then run 'daytona login'"
	local sandbox dir archive_dir local_state
	sandbox="$(sandbox_name_from_session)"
	dir="$(session_dir)"
	archive_dir="$SESSIONS_DIR/.archive/$NAME-$(date -u +'%Y%m%dT%H%M%SZ')"
	local_state="$(jq -r '.localState // "unknown"' "$(session_file)")"

	if [[ "$local_state" != deleted-* ]]; then
		daytona delete "$sandbox"
	fi
	mkdir -p "$(dirname "$archive_dir")"
	update_local_state "deleted"
	mv "$dir" "$archive_dir"
	note "deleted Daytona sandbox '$sandbox'"
	note "local metadata is recoverable at $archive_dir"
}

cmd_help() {
	cat <<'EOF'
Usage: ./scripts/remote COMMAND

Commands:
  init     Install the Daytona CLI if needed
  login    Authenticate with browser login or DAYTONA_API_KEY
  check    Verify local Daytona tooling
  secrets-init Install the Infisical CLI if needed
  secrets-check Verify Infisical machine identity configuration
  secrets-refresh Refresh a sandbox's short-lived Infisical token
  secrets-export Explicitly export sandbox secrets to .env.local
  aperture-check Verify a sandbox's private Aperture bridge
  codex-login Sign sandbox Codex in with ChatGPT device authentication
  snapshot Build a reusable snapshot from the local devcontainer
  start    Create a tracked sandbox
  list     List tracked sandboxes
  info     Show session and live Daytona metadata
  ssh      Open an SSH connection
  exec     Execute REMOTE_COMMAND in the workspace
  serve    Start a background dev server and generate its URL
  url      Generate and store a signed URL for a remote port
  portless Create a local SSH tunnel and friendly Portless URL
  portless-stop Stop tracked local tunnels and remove Portless aliases
  stop     Stop while preserving the sandbox filesystem
  resume   Start a stopped sandbox
  destroy  Delete the sandbox and archive local metadata
EOF
}

if [[ "${REMOTE_LIBRARY_ONLY:-0}" == "1" ]]; then
	return 0 2>/dev/null || exit 0
fi

case "$COMMAND" in
init) cmd_init ;;
login) cmd_login ;;
check) cmd_check ;;
secrets-init) cmd_secrets_init ;;
secrets-check) cmd_secrets_check ;;
secrets-refresh) cmd_secrets_refresh ;;
secrets-export) cmd_secrets_export ;;
aperture-check) cmd_aperture_check ;;
codex-login) cmd_codex_login ;;
snapshot) cmd_snapshot ;;
start) cmd_start ;;
list) cmd_list ;;
info) cmd_info ;;
ssh) cmd_ssh ;;
exec) cmd_exec ;;
serve) cmd_serve ;;
url) cmd_url ;;
portless) cmd_portless ;;
portless-stop) cmd_portless_stop ;;
stop) cmd_stop ;;
resume | start-stopped) cmd_resume ;;
destroy) cmd_destroy ;;
help | -h | --help) cmd_help ;;
*) die "unknown command '$COMMAND'; run ./scripts/remote help" ;;
esac
