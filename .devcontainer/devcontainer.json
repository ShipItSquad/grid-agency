{
	"name": "off-grid-studio",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"mounts": [
		"source=off-grid-studio-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
	],
	"postCreateCommand": "sudo chown -R node:node node_modules && pnpm install --frozen-lockfile --store-dir node_modules/.pnpm-store",
	"forwardPorts": [5173, 4723],
	"portsAttributes": {
		"5173": {
			"label": "SvelteKit",
			"onAutoForward": "openPreview"
		},
		"4723": {
			"label": "svelte-grab MCP HTTP bridge",
			"onAutoForward": "silent"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": ["svelte.svelte-vscode", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
		}
	},
	"remoteUser": "node"
}
