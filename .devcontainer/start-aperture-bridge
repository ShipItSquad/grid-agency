#!/bin/sh
set -eu

host="${APERTURE_HOST:-}"
port="${APERTURE_LOCAL_PORT:-41111}"
node_name="${APERTURE_NODE_NAME:-daytona}"
state_dir="${APERTURE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/aperture-tsnet}"
pid_file="$state_dir/ts-unplug.pid"
log_file="$state_dir/ts-unplug.log"

case "$host" in
"" | *[!a-zA-Z0-9.-]*)
	printf 'start-aperture-bridge: APERTURE_HOST must be a DNS hostname\n' >&2
	exit 1
	;;
esac
case "$port" in
"" | 0 | *[!0-9]*)
	printf 'start-aperture-bridge: APERTURE_LOCAL_PORT must be a positive integer\n' >&2
	exit 1
	;;
esac
if [ "$port" -gt 65535 ]; then
	printf 'start-aperture-bridge: APERTURE_LOCAL_PORT must not exceed 65535\n' >&2
	exit 1
fi
case "$node_name" in
"" | *[!a-zA-Z0-9.-]*)
	printf 'start-aperture-bridge: APERTURE_NODE_NAME contains unsupported characters\n' >&2
	exit 1
	;;
esac

umask 077
mkdir -p "$state_dir"
chmod 700 "$state_dir"

if [ -r "$pid_file" ]; then
	pid="$(cat "$pid_file")"
	if kill -0 "$pid" 2>/dev/null && curl -fsS "http://127.0.0.1:$port/v1/models" >/dev/null 2>&1; then
		printf 'start-aperture-bridge: bridge already available on port %s\n' "$port"
		exit 0
	fi
	rm -f "$pid_file"
fi

auth_key=""
if [ ! -s "$state_dir/tailscaled.state" ]; then
	IFS= read -r auth_key || true
	if [ -z "$auth_key" ]; then
		printf 'start-aperture-bridge: a one-use Tailscale auth key is required for first enrollment\n' >&2
		exit 1
	fi
fi

if [ -n "$auth_key" ]; then
	TS_AUTHKEY="$auth_key" nohup setsid ts-unplug \
		-dir "$state_dir" \
		-hostname "$node_name" \
		-debug-tsnet \
		-port "$port" \
		"$host" >"$log_file" 2>&1 &
else
	nohup setsid ts-unplug \
		-dir "$state_dir" \
		-hostname "$node_name" \
		-debug-tsnet \
		-port "$port" \
		"$host" >"$log_file" 2>&1 &
fi
pid="$!"
auth_key=""
printf '%s\n' "$pid" >"$pid_file"
chmod 600 "$pid_file" "$log_file"

attempt=0
while [ "$attempt" -lt 30 ]; do
	if curl -fsS "http://127.0.0.1:$port/v1/models" >/dev/null 2>&1; then
		printf 'start-aperture-bridge: Aperture available on port %s\n' "$port"
		exit 0
	fi
	if ! kill -0 "$pid" 2>/dev/null; then
		break
	fi
	attempt="$((attempt + 1))"
	sleep 1
done

kill "$pid" 2>/dev/null || true
rm -f "$pid_file"
printf 'start-aperture-bridge: bridge failed; inspect %s\n' "$log_file" >&2
exit 1
