{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"agent_browser": {
			"type": "local",
			"command": ["pnpm", "exec", "agent-browser", "mcp", "--tools", "all"],
			"enabled": true,
			"timeout": 30000
		},
		"svelte-grab": {
			"type": "local",
			"command": ["pnpm", "exec", "svelte-grab-mcp", "--stdio"],
			"enabled": true,
			"timeout": 30000
		}
	}
}
