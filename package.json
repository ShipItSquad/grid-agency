{
  "name": "off-grid-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/check-production-build.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''; husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && ultracite check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "pretest": "playwright install chromium",
    "test": "svelte-kit sync && playwright test",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24",
    "agent-browser": "0.33.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-grab": "^1.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "ultracite": "7.9.4",
    "vite": "^8.0.16",
    "wrangler": "^4.114.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.5.3"
  },
  "packageManager": "pnpm@11.5.3"
}
